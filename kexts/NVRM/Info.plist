	<dict>
		<key>NVRM</key>
		<dict>
			<key>CFBundleIdentifier</key>
			<string>com.nullmoth.NVRM</string>
			<key>IOClass</key>
			<string>NVRM</string>
			<key>IOProviderClass</key>
			<string>IOPCIDevice</string>
			<key>IOUserClientClass</key>
			<string>NVRMUserClient</string>
			<!-- ANY NVIDIA GPU. WAS 0x2d0510de = this box's RTX 5060 alone.
			     IOPCIPrimaryMatch compares the 32-bit (device<<16 | vendor) word, and its
			     "value&mask" form masks it first, so 0x000010de&0x0000ffff reads as
			     "vendor 0x10DE, any device". IOPCIClassMatch is ANDed with it and pins the
			     PCI base class to 0x03 (display) while leaving the subclass free, so both VGA
			     (0x00) and 3D-controller (0x02) cards match - the two NVIDIA itself accepts.
			     A mask match is a WIDE net ON PURPOSE. NVRM::probe() calls NVIDIA's own
			     rm_is_supported_pci_device() and go() calls rm_is_supported_device(), and THOSE
			     decide. If some card goes wrong, fix the gate - never narrow this to one id.-->
			<key>IOPCIPrimaryMatch</key>
			<string>0x000010de&amp;0x0000ffff</string>
			<key>IOPCIClassMatch</key>
			<string>0x03000000&amp;0xff000000</string>
			<key>IOProbeScore</key>
			<integer>1000</integer>
		</dict>
	</dict>
